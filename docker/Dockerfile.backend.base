# syntax=docker/dockerfile:1.7
# ===== 预构建基础镜像：只含 runtime 需要的系统包 =====
#
# 为什么拆出来（2026-11-24 实测）：
#   原 Dockerfile 的 runtime stage 里有一次 apt 安装（OCR/PDF/Office/中文字体，
#   约 200 个 deb 包）。这一层**极慢**（15–25 分钟，且遇网络抖动会产生大量
#   `Ign:` 重试），而它**不随业务代码变化**——业务代码只动最后那层 COPY。
#   但 Docker 缓存按「层指令 + 上游产物」判定，业务代码一变，整条链的
#   cache key 都变 ⇒ 每次改一行 Python 也要重装 200 个包。
#
# 拆开后：
#   - 基础镜像**只构建一次**（每个 platform 一次），之后固化成本为零；
#   - 业务镜像重建只跑最后一层 ⇒ 1–2 分钟；
#   - 发版包（docker save 业务镜像）**自带基础层** ⇒ 生产仍只需传一个 tar。
#
# 构建（必须先于业务镜像）：
#   docker buildx build --platform linux/amd64 \
#     -f docker/Dockerfile.backend.base \
#     -t qa-system-backend-base:2026-11-amd64 --load .
#
# 业务镜像（引用基础镜像）：
#   docker buildx build --platform linux/amd64 \
#     -f docker/Dockerfile.backend \
#     --build-arg RUNTIME_BASE=qa-system-backend-base:2026-11-amd64 \
#     -t qa-system-backend:amd64-<标识> --load .

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:/usr/local/bin:$PATH

WORKDIR /app

# OCR（扫描件 PDF）+ PDF 渲染（pdftoppm）。显式切到阿里云镜像源
# （base image 默认指向 deb.debian.org 经常 502/超时）；fonts-dejavu-core 等
# 大字体包尤其敏感。
RUN printf 'Types: deb\nURIs: https://mirrors.aliyun.com/debian\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: https://mirrors.aliyun.com/debian-security\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && for i in 1 2 3 4 5; do \
           apt-get update -o Acquire::Retries=5 -o Acquire::http::Timeout=30 && break; \
           echo "apt-get update retry $i/5 failed, sleeping 10s"; sleep 10; \
       done \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        poppler-utils \
        # Office → PDF（文档预览保真）：Excel/Word/PPT 由 LibreOffice 无头转换，
        # 浏览器原生 PDF 查看器渲染。**不加** libreoffice-core 全家桶：
        # 只装三个应用包，省掉 Base/Math 等无关组件。
        libreoffice-calc \
        libreoffice-writer \
        libreoffice-impress \
        # 中文字体（缺少会在转出的 PDF 里显示方框）
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

EXPOSE 8000
