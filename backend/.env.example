# ===== 容器外端口契约（宿主端口） =====
# 本文件用于容器外跑 uvicorn / alembic / pytest。
# 推荐统一入口：./scripts/run_local.sh（自动 export + 端口预检 + SSOT 防御）。
#
# ⚠️  DATABASE_URL 必须是 localhost:5433（不是 5432）：
#   docker-compose 把宿主端口映射成 5433 → 容器端口 5432（避让本机 openmetadata 的 5432）。
#   见 Harness/wiki/operations-runbook.md「SSOT 端口契约」段。
#
# 容器内运行请用 docker/.env（写 postgres:5432 容器 service 名 + 容器端口）。

# ===== 基础设施密码（与 docker/.env 一致） =====
POSTGRES_PASSWORD=qa_pg_dev_2026
NEO4J_PASSWORD=qa_neo4j_dev_2026

# ===== 应用密钥（Fernet） =====
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 必须与 docker/.env 的 SECRET_KEY 一致，否则 datasource 密码解密会失败。
SECRET_KEY=replace_with_fernet_key
SESSION_BUDGET=0.1

# ===== 后端：宿主端口 =====
DATABASE_URL=postgresql+asyncpg://qa_user:qa_pg_dev_2026@localhost:5433/qa_metadata
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qa_neo4j_dev_2026
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=ontology_embeddings
APP_ENV=development
LOG_LEVEL=INFO

# ===== LLM API Keys（按需填写） =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_BASE_URL=http://localhost:11434

# ===== Embedding（语义检索） =====
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_BASE=http://localhost:11434/v1
EMBEDDING_API_KEY=ollama
# 容器外不需要 host.docker.internal 改写（resolver 用 localhost 直连本机 Ollama）。
EMBEDDING_HOST_OVERRIDE=
LLM_TRUST_ENV=false