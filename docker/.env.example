# ===== 容器内端口契约 SSOT =====
# 本文件是 docker-compose 后端服务的 SSOT。DATABASE_URL/NEO4J_URI/MILVUS_URI 用的是
# 容器 service 名（postgres / neo4j / milvus-standalone）+ 容器端口（如 5432）。
#
# 容器外跑 uvicorn（./scripts/run_local.sh）请用 backend/.env（也提供 .env.example
# 模板），端口用 localhost:5433（宿主端口已重映射，详见 docker-compose.yml 的
# 5433:5432 端口映射段）。
#
# 任何端口改动只动 docker-compose.yml 端口映射，本文件保留容器内端口即可。
#
# 详见 Harness/wiki/operations-runbook.md「SSOT 端口契约」段。

# ===== 基础设施密码 =====
POSTGRES_PASSWORD=qa_pg_dev_2026
NEO4J_PASSWORD=qa_neo4j_dev_2026
MYSQL_ROOT_PASSWORD=qa_mysql_dev_2026
MYSQL_USER=harness_user
MYSQL_PASSWORD=harness_pwd_2026

# ===== 应用密钥 =====
# Fernet key for encrypting datasource passwords. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace_with_fernet_key
SESSION_BUDGET=0.1

# ===== 数据源主机白名单（可选，逗号分隔；为空则不限制） =====
DATASOURCE_HOST_ALLOWLIST=

# ===== 后端 =====
DATABASE_URL=postgresql+asyncpg://qa_user:qa_pg_dev_2026@postgres:5432/qa_metadata
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qa_neo4j_dev_2026
MILVUS_URI=http://milvus-standalone:19530
MILVUS_COLLECTION=ontology_embeddings
APP_ENV=development
LOG_LEVEL=INFO

# ===== LLM API Keys（按需填写） =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===== Embedding（语义检索） =====
# 激活的 embedding_provider（registry）优先，env 仅作回退。bge-m3 系列 1024 维，与
# Milvus 集合维度一致；勿用 text-embedding-3-small（1536 维，与 1024 集合冲突）。
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
# 容器内 localhost 指向容器自身；resolver 将激活 provider 的 localhost 主机名改写为该值，
# 以访问宿主机上运行的 Ollama / oMLX（provider seed 的 base_url 为 localhost 规范写法）。
# 宿主机直接部署时留空。
EMBEDDING_HOST_OVERRIDE=host.docker.internal
# 绕过系统/环境代理（容器内无 macOS 系统代理）；需经代理访问外部 LLM 时改为 true。
LLM_TRUST_ENV=false

# ===== 前端 =====
VITE_API_BASE_URL=http://localhost:8000/api/v1
