# CODEOWNERS —— CI 相关面的合并授权落点
#
# 为什么要这个文件（依据）：
#   Harness/changes/fix-ci-integration-hardening/summary.md §7 的安全评审结论
#   （C-1 / H-1 / H-2）：**日志解析无法对「敌意 PR 作者」证明可靠** ——
#   pytest 的 stdout（完成标记、收尾汇总行、FAILED 行）都由 PR 作者可控
#   ⇒ 工具能挡住**偶然**的假绿（cancelled / 夭折 / OOM / 改 conftest），
#   但挡不住「作者主动伪造 stdout」。
#   ⇒ 合并授权必须落在**人**身上：
#      ① 保护分支 + 必需状态检查；② 这些路径的 CODEOWNER 复核。
#
# 缺了这个文件 ⇒ 上面第 ② 条落空 ⇒ 工具的「可合并」结论就成了唯一防线。

# ---- CI 工作流本身（分片、完成标记、超时、权限）----
/.github/workflows/            @sunql

# ---- 失败集合对差工具的**每一个**模块 ----
# 改判定逻辑 = 改「可合并」的判据（ci_judge.py 尤其关键：
# 改它就能把「被取消的 job」判成「可用」⇒ 空的失败集合参与对差）。
backend/app/utils/ci_shard.py         @sunql
backend/app/utils/ci_failure_set.py   @sunql
backend/app/utils/ci_judge.py         @sunql
backend/app/utils/ci_report.py        @sunql
backend/app/utils/ci_text.py          @sunql
backend/app/utils/ci_gh.py            @sunql
backend/app/utils/ci_surface.py       @sunql
backend/app/utils/ci_head.py          @sunql
backend/app/utils/ci_pytest_log.py    @sunql
backend/app/utils/ci_flakes.py        @sunql

# ---- 已知抖动白名单**数据文件**（它直接决定「哪些失败用例不作判据」⇒ 改它 = 改判据）----
.github/ci-known-flaky-tests.json    @sunql

# ---- 变异取证脚本（它决定「哪些变异能转红」⇒ 改它就能让守卫恒绿）----
# 清单（纯数据）与跑者同族：改清单可以把某组变异指向没人守的地方 ⇒ 照样恒绿。
backend/scripts/ci_mutation_cases.py      @sunql
backend/scripts/ci_mutation_evidence.py   @sunql

# ---- CODEOWNERS **自己**（改授权面 = 换授权人 ⇒ 必须人工复核）----
# 个人仓库的 CODEOWNERS 没有强制力（装不了 users bypass）⇒ 这是链上仅剩的人工检查点。
/.github/CODEOWNERS                  @sunql

