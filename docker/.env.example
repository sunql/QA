# ===== 容器内端口契约 SSOT =====
# 本文件是 docker-compose 后端服务的 SSOT。DATABASE_URL/NEO4J_URI/MILVUS_URI 用的是
# 容器 service 名（postgres / neo4j / milvus-standalone）+ 容器端口（如 5432）。
#
# 容器外跑 uvicorn（./scripts/run_local.sh）请用 backend/.env（也提供 .env.example
# 模板），端口用 localhost:5433（宿主端口已重映射，详见 docker-compose.yml 的
# 5433:5432 端口映射段）。
#
# 任何端口改动只动 docker-compose.yml 端口映射，本文件保留容器内端口即可。
#
# 详见 Harness/wiki/operations-runbook.md「SSOT 端口契约」段。

# ===== 基础设施密码 =====
POSTGRES_PASSWORD=qa_pg_dev_2026
NEO4J_PASSWORD=qa_neo4j_dev_2026
MYSQL_ROOT_PASSWORD=qa_mysql_dev_2026
MYSQL_USER=harness_user
MYSQL_PASSWORD=harness_pwd_2026

# ===== 知识源文件对象存储（qa-objects / MinIO） =====
# docker-compose 里 qa-objects 与 backend 都用 ${MINIO_ROOT_USER:?...} 强校验，
# 缺了会直接 compose 启动失败，因此这里显式占位提醒（值本身别提交真实凭据）。
MINIO_ROOT_USER=replace_with_minio_user
MINIO_ROOT_PASSWORD=replace_with_minio_password

# ===== 应用密钥 =====
# Fernet key for encrypting datasource passwords. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=replace_with_fernet_key
SESSION_BUDGET=0.1

# ===== 登录认证（JWT） =====
# JWT_SECRET 必填：/auth/login 签发 token 用，为空时登录直接 500
# （jwt.exceptions.InvalidKeyError: HMAC key must not be empty）。
# 生成：python -c "import secrets; print(secrets.token_hex(32))"   # 64 hex 字符
JWT_SECRET=replace_with_jwt_secret_min_32_bytes
# AUTH_MODE=stub（dev 免登，X-User-* 头可用）/ real（强制 JWT，stub 头被拒）
AUTH_MODE=stub

# ===== 数据源主机白名单（可选，逗号分隔；为空则不限制） =====
DATASOURCE_HOST_ALLOWLIST=

# ===== 后端 =====
DATABASE_URL=postgresql+asyncpg://qa_user:qa_pg_dev_2026@postgres:5432/qa_metadata
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=qa_neo4j_dev_2026
MILVUS_URI=http://milvus-standalone:19530
MILVUS_COLLECTION=ontology_embeddings
APP_ENV=development
LOG_LEVEL=INFO

# ===== NL2SQL 行数兜底 =====
# 无范围/无显式 LIMIT 的明细查询被自动注入 ROWNUM <= N；<=0 关闭兜底（默认 0）。
# 与 _SQL_DIALECTS_ORACLE_11G.limitRule 示例值（1000）保持一致。
NL2SQL_NO_SCOPE_ROW_LIMIT=1000

# ===== LLM API Keys（按需填写） =====
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ===== Embedding（语义检索） =====
# 激活的 embedding_provider（registry）优先，env 仅作回退。bge-m3 系列 1024 维，与
# Milvus 集合维度一致；勿用 text-embedding-3-small（1536 维，与 1024 集合冲突）。
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_API_BASE=http://host.docker.internal:11434/v1
EMBEDDING_API_KEY=ollama
# 容器内 localhost 指向容器自身；resolver 将激活 provider 的 localhost 主机名改写为该值，
# 以访问宿主机上运行的 Ollama / oMLX（provider seed 的 base_url 为 localhost 规范写法）。
# 宿主机直接部署时留空。
EMBEDDING_HOST_OVERRIDE=host.docker.internal
# env 回退 embedding 路径的输出维度声明（H7 残留关闭）。active provider（id=2 oMLX bge-m3 8bit）
# 维度 1024；active 路径不读本变量，但 DB 抖动 / 无 active provider 时回退本变量 + 此维度守卫，
# 避免静默「写错维度到 Milvus」。改值须先确认 Milvus 集合维度一致，否则 ConfigError fail-fast。
# 合法取值与当前模型：bge-m3 系列 = 1024；text-embedding-3-small = 1536（需先重建集合）。
EMBEDDING_DIMENSION=1024
# 绕过系统/环境代理（容器内无 macOS 系统代理）；需经代理访问外部 LLM 时改为 true。
LLM_TRUST_ENV=false

# ===== 前端 =====
VITE_API_BASE_URL=http://localhost:8000/api/v1
