# syntax=docker/dockerfile:1.7
# -------- builder：含编译工具链 --------
FROM python:3.12-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# 显式切到阿里云镜像源（base image 默认指向 deb.debian.org 经常 502/超时）。
# trixie = Debian 13，python:3.12-slim 当前是 trixie。
RUN printf 'Types: deb\nURIs: https://mirrors.aliyun.com/debian\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: https://mirrors.aliyun.com/debian-security\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n' > /etc/apt/sources.list.d/debian.sources \
    && rm -f /etc/apt/sources.list \
    && for i in 1 2 3 4 5; do \
           apt-get update -o Acquire::Retries=5 -o Acquire::http::Timeout=30 && break; \
           echo "apt-get update retry $i/5 failed, sleeping 10s"; sleep 10; \
       done \
    && apt-get install -y --no-install-recommends build-essential curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 装 uv（PyPI 装 wheel，比 GitHub release tarball 稳）。
# 2026-09-01 命中过 GitHub releases 连续 TLS 中断 + PyPI HTTPSConnectionPool 超时。
# 切到阿里云 PyPI 镜像 + retry 解决网络抖动。
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple/ \
    && for i in 1 2 3 4 5; do \
         pip install --no-cache-dir --default-timeout=60 --upgrade uv \
         && break; \
         echo "uv pip install retry $i/5 failed, sleeping 10s"; sleep 10; \
       done

# 先拷依赖文件以利用缓存（README.md 供 hatchling 构建元数据）
COPY backend/pyproject.toml backend/uv.lock* backend/README.md ./

# 装依赖到 /app/.venv（无锁文件时回退到解析）
RUN uv sync --frozen --no-dev || uv sync --no-dev

# 拷源码
COPY backend/ ./

# 清理 .pyc 与 tests 占空间（uv sync --no-dev 已过滤 dev，但保险再清一次）
RUN find /app/.venv -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true; \
    find /app/.venv -type f -name '*.pyc' -delete

# -------- runtime：仅留运行所需 --------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH=/app/.venv/bin:/usr/local/bin:$PATH

WORKDIR /app

# OCR（扫描件 PDF）+ PDF 渲染（pdftoppm）
RUN apt-get update -o Acquire::Retries=5 -o Acquire::http::Timeout=30 \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        tesseract-ocr-chi-sim \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# 从 builder 复制 venv + 源码 + uv 二进制
COPY --from=builder /app /app
COPY --from=builder /usr/local/bin/uv /usr/local/bin/uv
COPY --from=builder /usr/local/bin/uvx /usr/local/bin/uvx

EXPOSE 8000

# 启动前执行数据库迁移，再运行 uvicorn
CMD ["sh", "-c", "uv run alembic upgrade head && uv run uvicorn app.main:app --host 0.0.0.0 --port 8000"]